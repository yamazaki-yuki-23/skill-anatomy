{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["**/dist/**"],
  "rules": {
    "typescript/consistent-type-imports": "error",
    "unicorn/prefer-node-protocol": "error",
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true
      }
    ],
    "style/naming": "error",
    "id-match": [
      "error",
      "^([a-z][a-zA-Z0-9]*|[A-Z][a-zA-Z0-9]*|[A-Z][A-Z0-9_]*|_)$",
      {
        "properties": false,
        "ignoreDestructuring": true
      }
    ]
  },
  "jsPlugins": ["./scripts/style-rules.mjs"]
}
