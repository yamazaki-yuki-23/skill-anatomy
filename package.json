{
  "name": "skill-anatomy",
  "version": "0.3.0",
  "private": true,
  "description": "GitHub skill research preparation and resumable analysis for AI agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun --bun tsc --noEmit",
    "check:dist": "bun scripts/check-dist.mjs",
    "lint": "bun --bun oxlint --deny-warnings .",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "test": "bun --bun vitest run",
    "test:security": "bun scripts/security-eval.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.8"
}
